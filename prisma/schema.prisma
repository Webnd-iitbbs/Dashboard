generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password       String?
  isMentor       Boolean          @default(false)
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isActive       Boolean          @default(true)
  mentorRequests MentorRequest[]
  mentorLinks    MentorStudent[]  @relation("Mentor")
  studentLinks   MentorStudent[]  @relation("Student")
  createdTasks   Task[]           @relation("TaskCreator")
  assignedTasks  TaskAssignment[] @relation("AssignedStudent")
}

model MentorRequest {
  id        String              @id @default(cuid())
  userId    String
  reason    String?
  status    MentorRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id])
}

model MentorStudent {
  id        String   @id @default(cuid())
  mentorId  String
  studentId String
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  mentor    User     @relation("Mentor", fields: [mentorId], references: [id])
  student   User     @relation("Student", fields: [studentId], references: [id])
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String
  points      Int              @default(0)
  deadline    DateTime?
  mentorId    String
  createdAt   DateTime         @default(now())
  mentor      User             @relation("TaskCreator", fields: [mentorId], references: [id])
  assignments TaskAssignment[]
}

model TaskAssignment {
  id         String     @id @default(cuid())
  taskId     String
  studentId  String
  status     TaskStatus @default(PENDING)
  assignedAt DateTime   @default(now())
  student    User       @relation("AssignedStudent", fields: [studentId], references: [id])
  task       Task       @relation(fields: [taskId], references: [id])
}

enum MentorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}
